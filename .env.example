# Copy to .env; do not commit .env.
# Avoid $ in the password unless escaped as $$ in Compose files.
RSTUDIO_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Default: accessible only on the Docker host itself.
# Remote access: prefer an SSH tunnel or HTTPS reverse proxy with authentication.
# Exposing 0.0.0.0 without TLS/firewall is NOT recommended.
BIND_ADDRESS=127.0.0.1
RSTUDIO_PORT=8787

# Image and R version
IMAGE_NAME=local/ml-cv-rstudio
IMAGE_TAG=latest
R_VERSION=4.5.2

# Set to `id -u` and `id -g` from the Linux Docker host if needed.
USER_ID=1000
GROUP_ID=1000

SHM_SIZE=1gb
TZ=Europe/Berlin
