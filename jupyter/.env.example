# Copy this file to .env (inside jupyter/). Never commit .env.
# Use a long, randomly generated token; avoid $ unless escaped as $$ in Compose.
JUPYTER_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_TOKEN

# Host-local by default. Prefer SSH tunneling or a secured HTTPS reverse proxy.
BIND_ADDRESS=127.0.0.1
JUPYTER_PORT=8888

# 'lab' (JupyterLab) or 'notebook' (Notebook 7)
JUPYTER_FRONTEND=lab

# Image customization. Use a dated, known-good tag for reproducibility.
JUPYTER_BASE_IMAGE=quay.io/jupyter/r-notebook:2026-07-28
IMAGE_NAME=local/ml-cv-jupyter
IMAGE_TAG=latest

SHM_SIZE=1gb
TZ=Europe/Berlin
